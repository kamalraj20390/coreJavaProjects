package com.adda.app.dao.impl;

import java.util.List;

import com.adda.app.bean.Course;
import com.adda.app.bean.Student;
import com.adda.app.dao.CourseDao;
import com.adda.app.util.DataStore;

public class CourseDaoImpl implements CourseDao {

	@Override
	public void addCourse(Course course) {
		DataStore.courses.add(course);
		
	}

	@Override
	public List<Course> getAllCourses() {
		return DataStore.courses;
	}

	@Override
	public Course getCourseById(int id) {
		for (Course course : DataStore.courses) {
			if(id==course.getId())
				return course;
		}
		return null;
	}

}
