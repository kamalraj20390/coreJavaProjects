		}
		
	}
	private static void viewEnrollments() {

	    System.out.println();
	    System.out.println("--------------------------------------------------------------------------");
	    System.out.println("                         ENROLLMENT LIST");
	    System.out.println("--------------------------------------------------------------------------");

	    List<Enrollment> enrollments =
	            enrollmentService.getAllEnrollment();

	    if (enrollments.isEmpty()) {
	        System.out.println("No enrollments available.");
	        return;
	    }

	    System.out.printf(
	            "%-15s %-15s %-20s %-15s %-25s%n",
	            "ENROLLMENT ID",
	            "STUDENT ID",
	            "STUDENT NAME",
	            "COURSE ID",
	            "COURSE NAME"
	    );

	    System.out.println(
	            "----------------------------------------------------------------------------------------"
	    );

	    for (Enrollment enrollment : enrollments) {

	        System.out.printf(
	                "%-15d %-15d %-20s %-15d %-25s%n",
	                enrollment.getId(),
	                enrollment.getStudent().getId(),
	                enrollment.getStudent().getName(),
	                enrollment.getCourse().getId(),
	                enrollment.getCourse().getCourseName()
	        );
	    }

	    System.out.println(
	            "----------------------------------------------------------------------------------------"
	    );
	}

	private static void viewStudentWiseEnrollment() {

	    System.out.println();
	    System.out.println("Enter Student ID");

	    int studentId =
	            InputUtil.getInt("Student ID: ");

	    Student student =
	            studentService.getStudentById(studentId);

	    if (student == null) {

	        System.out.println("Student not found!");
	        return;
	    }

	    System.out.println();
	    System.out.println(
	            "Student : " + student.getName()
	    );

	    System.out.println();
	    System.out.println(
	            "----------------------------------------------------------------"
	    );

	    System.out.printf(
	            "%-15s %-15s %-25s %-20s%n",
	            "ENROLLMENT ID",
	            "COURSE ID",
	            "COURSE NAME",
	            "TRAINER"
	    );

	    System.out.println(
	            "----------------------------------------------------------------"
	    );

	    boolean found = false;

	    for (Enrollment enrollment :
	            enrollmentService.getAllEnrollment()) {

	        if (enrollment.getStudent().getId()
	                == studentId) {

	            System.out.printf(
	                    "%-15d %-15d %-25s %-20s%n",
	                    enrollment.getId(),
	                    enrollment.getCourse().getId(),
	                    enrollment.getCourse().getCourseName(),
	                    enrollment.getCourse().getTrainer()
	            );

	            found = true;
	        }
	    }

	    if (!found) {

	        System.out.println(
	                "No course enrolled."
	        );
	    }

	    System.out.println(
	            "----------------------------------------------------------------"
	    );
	}

	private static void viewCourseWiseEnrollment() {

	    System.out.println();

	    int courseId =
	            InputUtil.getInt("Course ID: ");

	    Course course =
	            courseService.getCourseById(courseId);

	    if (course == null) {

	        System.out.println("Course not found!");
	        return;
	    }

	    System.out.println();
	    System.out.println(
	            "Course : " + course.getCourseName()
	    );

	    System.out.println();
	    System.out.println(
	            "--------------------------------------------------------------------------"
	    );

	    System.out.printf(
	            "%-15s %-15s %-20s %-30s%n",
	            "ENROLLMENT ID",
	            "STUDENT ID",
	            "STUDENT NAME",
	            "EMAIL"
	    );

	    System.out.println(
	            "--------------------------------------------------------------------------"
	    );

	    boolean found = false;

	    for (Enrollment enrollment :
	            enrollmentService.getAllEnrollment()) {

	        if (enrollment.getCourse().getId()
	                == courseId) {

	            System.out.printf(
	                    "%-15d %-15d %-20s %-30s%n",
	                    enrollment.getId(),
	                    enrollment.getStudent().getId(),
	                    enrollment.getStudent().getName(),
	                    enrollment.getStudent().getEmail()
	            );

	            found = true;
	        }
	    }

	    if (!found) {

	        System.out.println(
	                "No students enrolled."
	        );
	    }

	    System.out.println(
	            "--------------------------------------------------------------------------"
	    );
	}
	private static void enrollStudent() {
		System.out.println();
		System.out.println("--------------ENROLLMENT---------------");
		if (studentService.getAllStudents().isEmpty()) {
			System.out.println("Please Add At least One Student !");
			return;
		}
		if (courseService.getAllCourses().isEmpty()) {
			System.out.println("Please Add At least One Course !");
			return;
		}
		int enrollmentId=InputUtil.getInt("Enter Enrollment Id");
		Enrollment enrollment=enrollmentService.getEnrollmentById(enrollmentId);
		System.out.println(enrollment+" "+enrollmentId);
		if (enrollment!=null) {
			System.out.println("Enrolment already Exist !");
			return;
		}
		int studentId=InputUtil.getInt("Enter Student Id");
		Student student=studentService.getStudentById(studentId);
		if (student==null) {
			System.out.println("Student Not Found");
			return;
		}
		int courseId=InputUtil.getInt("Enter Course Id");
		Course course=courseService.getCourseById(courseId);
		if (course==null) {
			System.out.println("Course Not Found");
			return;
		}
		
		if (enrollmentService.isAlreadyEnrolled(studentId, courseId)) {
			System.out.println();
			System.out.println("Student is Already Enrolled in this Course !");
			return;
		}
		boolean result=enrollmentService.addEnrollment(enrollment);
		if (result) {
			System.out.println();
			System.out.println("=================================");
			System.out.println("Enrollment Successful");
			System.out.println("Student : "+student.getName());
			System.out.println("Course : "+course.getCourseName());
			System.out.println("=================================");
		}else {
			System.out.println();
			System.out.println("Enrollment Failed");
		}
		
	}
	private static void viewMenu() {
		System.out.println();
		System.out.println("--------------VIEW---------------");
		System.out.println("1. View Student");
		System.out.println("2. View Course");
		System.out.println("3. Back");
		int choice = InputUtil.getInt("Enter Your Choice: ");
		switch (choice) {
		case 1:
				viewStudent();
			break;
		case 2:
				viewCourse();
			break;
		case 3:
				return;
		default:
			System.out.println("Invalid Choice! ");
		}
		
	}
	private static void viewCourse() {
	    System.out.println();
	    System.out.println("------------------------ ALL COURSES -------------------------");

	    List<Course> courses = courseService.getAllCourses();

	    if (courses.isEmpty()) {
	        System.out.println("No Courses Available.");
	        return;
	    }

	    System.out.printf("%-5s %-20s %-20s %-10s%n",
	            "ID", "COURSE NAME", "TRAINER", "FEE");

	    System.out.println("------------------------------------------------------------");

	    for (Course course : courses) {
	        System.out.printf("%-5d %-20s %-20s %-10.2f%n",
	                course.getId(),
	                course.getCourseName(),
	                course.getTrainer(),
	                course.getFee());
	    }

	    System.out.println("------------------------------------------------------------");
	}
	private static void viewStudent() {
	    System.out.println();
	    System.out.println("-------------- ALL STUDENTS ---------------");

	    List<Student> students = studentService.getAllStudents();

	    if (students.isEmpty()) {
