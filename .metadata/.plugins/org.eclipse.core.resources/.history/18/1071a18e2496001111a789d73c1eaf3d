	private static void viewEnrollMenu() {
		System.out.println();
		System.out.println("--------------VIEW---------------");
		System.out.println("1. View Enrollments");
		System.out.println("2. View Enrollments By Student");
		System.out.println("3. View Enrollments By Course");
