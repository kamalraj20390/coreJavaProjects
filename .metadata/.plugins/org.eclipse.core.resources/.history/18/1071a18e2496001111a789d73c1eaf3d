	private static void addCourse() {
		System.out.println();
		System.out.println("--------------ADD COURSE-------------");
		int id=InputUtil.getInt("Enter Course Id :");
		String name = InputUtil.getString("Enter Course Name :");
		String trainer = InputUtil.getString("Enter Trainer :");
		double fee = InputUtil.getDouble("Enter Fee :");
		Course course=new Course(id, name, trainer, fee);
		boolean result=courseService.addCourse(course);
		if(result) {
			System.out.println();
			System.out.println("Course Added Successfully!");
		}else {
			System.out.println();
			System.out.println("Course Id Already Exist!");
		}
		
	}
	private static void addStudent() {
		System.out.println();
		System.out.println("--------------ADD STUDENT-------------");
		int id=InputUtil.getInt("Enter Student Id :");
		String name = InputUtil.getString("Enter Your Name :");
		String email = InputUtil.getString("Enter Email :");
		String mobile = InputUtil.getString("Enter Mobile :");
		Student student=new Student(id, name, email, mobile);
		boolean result=studentService.addStudent(student);
		if(result) {
			System.out.println();
			System.out.println("Student Added Successfully!");
		}else {
			System.out.println();
			System.out.println("Student Id Already Exist!");
		}
	}

